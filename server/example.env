# Copy to server/.env (ignored by Git) and fill in. Every value is read at start-up.

# Where the server listens. Use 127.0.0.1 behind cloudflared or Caddy on the
# same machine; 0.0.0.0 only inside a container whose port is published to a
# loopback or private address.
HOST=127.0.0.1
PORT=8090

# The public origin players open (no trailing slash). Discord's OAuth2
# redirect URI is PUBLIC_ORIGIN/auth/callback.
PUBLIC_ORIGIN=https://halo.example.com
# Other origins allowed to open relay sockets, comma-separated, e.g. the
# Discord Activity: https://<application id>.discordsays.com
EXTRA_ORIGINS=

# build/web from `ninja web` (halo.html, halo.js, halo.wasm), and a directory
# holding ui.map and the multiplayer maps extracted from your own disc.
BUILD_DIR=/opt/halo/build
MAPS_DIR=/opt/halo/maps
# The lobby's images from your own ui.map (tools/web/extract-ui-images.mjs);
# defaults to $MAPS_DIR/ui.
# UI_DIR=/opt/halo/maps/ui

# Discord application (Developer Portal > OAuth2) and the servers whose
# members may play. Prefer the comma-separated allowlist; when set, it takes
# precedence over the legacy setting, even if empty.
# DISCORD_GUILD_IDS=<guild-id>[,<guild-id>...]
# The legacy single-server fallback is used only when DISCORD_GUILD_IDS is unset.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# At least 32 random characters, e.g. `openssl rand -base64 48`.
TOKEN_SECRET=
TOKEN_TTL_SECONDS=3600
# Renewals keep a session going for at most this long after the Discord
# sign-in (default 24 h); then the player signs in again, which re-checks
# the server allowlist. Silent for a player who already authorized the app.
SESSION_LIFETIME_SECONDS=86400

# none (direct), cloudflare (behind cloudflared: CF-Connecting-IP) or
# forwarded (behind Caddy: X-Forwarded-For).
TRUST_PROXY=none
AUTH_RATE_LIMIT_PER_MINUTE=30
MAX_ROOMS=64

# Local testing only: NODE_ENV=development, HOST on loopback and DEV_LOGIN=1
# enable /auth/dev-login?name=... without Discord.
NODE_ENV=production
DEV_LOGIN=0
