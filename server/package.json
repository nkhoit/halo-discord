{
  "name": "halo-relay-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "vitest run --exclude test/lab-end-match-chrome.test.ts",
    "check": "tsc --noEmit && vitest run --exclude test/lab-end-match-chrome.test.ts",
    "test:lab-end-match": "vitest run test/lab-end-match-chrome.test.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "esbuild": "0.28.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/ws": "8.18.1",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
